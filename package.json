{
  "name": "tracking-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "cd server && npm run dev",
    "dev:simulate": "cd server && npm run simulate",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\" \"npm run dev:simulate\"",
    "build": "next build && cd server && npm install && npm run build",
    "start": "concurrently \"next start\" \"npm run start:server\" \"cd server && npm run start:simulate\"",
    "start:server": "cd server && npm start",
    "lint": "eslint"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "leaflet": "^1.9.4",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
